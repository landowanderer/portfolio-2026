{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landowanderer.com/schemas/career-agent-job.schema.json",
  "title": "Harry Career Agent Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "canonical_url",
    "source_name",
    "source_url",
    "also_seen_on",
    "company",
    "title",
    "primary_track",
    "secondary_track",
    "location",
    "remote_type",
    "employment_type",
    "salary_min",
    "salary_max",
    "salary_currency",
    "date_posted",
    "date_discovered",
    "last_verified",
    "requisition_id",
    "experience_required",
    "education_required",
    "work_authorization_text",
    "sponsorship_text",
    "role_summary",
    "responsibilities",
    "required_skills",
    "preferred_skills",
    "portfolio_requirements",
    "fit_score",
    "confidence_score",
    "score_components",
    "confidence_components",
    "fit_reasons",
    "gaps",
    "red_flags",
    "recommended_resume",
    "recommended_projects",
    "status",
    "next_action",
    "staffing_agency",
    "fact_sources",
    "inferences"
  ],
  "properties": {
    "job_id": {"type": "string", "minLength": 3},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_name": {"type": "string", "minLength": 2},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "also_seen_on": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "company": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "primary_track": {"enum": ["A", "B", "C"]},
    "secondary_track": {"type": ["string", "null"], "enum": ["A", "B", "C", null]},
    "location": {"type": "string", "minLength": 1},
    "remote_type": {"enum": ["Remote", "Hybrid", "On-site", "Unknown"]},
    "employment_type": {"enum": ["Full-time", "Part-time", "Contract", "Freelance", "Internship", "Unknown"]},
    "salary_min": {"type": ["number", "null"], "minimum": 0},
    "salary_max": {"type": ["number", "null"], "minimum": 0},
    "salary_currency": {"type": ["string", "null"]},
    "date_posted": {"type": ["string", "null"], "format": "date"},
    "date_discovered": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "requisition_id": {"type": ["string", "null"]},
    "experience_required": {"type": "string"},
    "education_required": {"type": "string"},
    "work_authorization_text": {"type": "string"},
    "sponsorship_text": {"type": "string"},
    "role_summary": {"type": "string"},
    "responsibilities": {"type": "array", "items": {"type": "string"}},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "preferred_skills": {"type": "array", "items": {"type": "string"}},
    "portfolio_requirements": {"type": "string"},
    "fit_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidence_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_match",
        "portfolio_evidence",
        "experience_level",
        "work_quality",
        "location_work_mode",
        "work_authorization",
        "freshness",
        "company_industry_value"
      ],
      "properties": {
        "track_match": {"type": "integer", "minimum": 0, "maximum": 25},
        "portfolio_evidence": {"type": "integer", "minimum": 0, "maximum": 20},
        "experience_level": {"type": "integer", "minimum": 0, "maximum": 15},
        "work_quality": {"type": "integer", "minimum": 0, "maximum": 10},
        "location_work_mode": {"type": "integer", "minimum": 0, "maximum": 10},
        "work_authorization": {"type": "integer", "minimum": 0, "maximum": 10},
        "freshness": {"type": "integer", "minimum": 0, "maximum": 5},
        "company_industry_value": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "confidence_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_jd_access",
        "open_status_verified",
        "jd_completeness",
        "posting_date_clarity",
        "dedupe_confidence"
      ],
      "properties": {
        "original_jd_access": {"type": "integer", "minimum": 0, "maximum": 30},
        "open_status_verified": {"type": "integer", "minimum": 0, "maximum": 25},
        "jd_completeness": {"type": "integer", "minimum": 0, "maximum": 20},
        "posting_date_clarity": {"type": "integer", "minimum": 0, "maximum": 15},
        "dedupe_confidence": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "fit_reasons": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "gaps": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "red_flags": {"type": "array", "items": {"type": "string"}},
    "recommended_resume": {"type": "string"},
    "recommended_projects": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string"}},
    "status": {
      "enum": [
        "discovered",
        "shortlisted",
        "needs_review",
        "approved",
        "application_ready",
        "applied",
        "contact_drafted",
        "contacted",
        "recruiter_screen",
        "interview",
        "waiting",
        "offer",
        "rejected",
        "closed",
        "archived"
      ]
    },
    "next_action": {"type": "string"},
    "staffing_agency": {"type": "boolean"},
    "fact_sources": {
      "type": "object",
      "required": [
        "location",
        "employment_type",
        "salary",
        "date_posted",
        "experience",
        "work_authorization",
        "sponsorship"
      ],
      "properties": {
        "location": {"type": "string"},
        "employment_type": {"type": "string"},
        "salary": {"type": "string"},
        "date_posted": {"type": "string"},
        "experience": {"type": "string"},
        "work_authorization": {"type": "string"},
        "sponsorship": {"type": "string"}
      }
    },
    "inferences": {"type": "array", "items": {"type": "string"}}
  }
}
